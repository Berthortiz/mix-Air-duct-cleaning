---
import { Icon } from "astro-icon/components";
import olivaresImg from "../assets/img/olivares.png";
import mariaImg from "../assets/img/maria.png";
import fgcImg from "../assets/img/FGC.png";

const testimonials = [
  {
    description:
      "Increíble servicio para mi hogar en Miami. Limpiaron los ductos de aire en un par de horas y la diferencia en la calidad del aire se sintió de inmediato. Súper profesionales, puntuales y dejaron todo impecable.",
    name: "Jeaustin Olivares",
    job: "Propietario en Miami",
    srcImg: olivaresImg,
  },
  {
    description:
      "Con el calor de Florida, nuestro aire acondicionado trabaja sin parar. El mantenimiento y lavado de climas que realizaron fue de diez; el equipo ahora enfría mucho mejor y el consumo de energía bajó notablemente.",
    name: "Maria Martell",
    job: "Administradora de Propiedades",
    srcImg: mariaImg,
  },
  {
    description:
      "Excelente trabajo de limpieza profunda en los ductos y sistemas de aire de nuestras oficinas. Eliminaron todo el polvo y moho acumulado. La atención al detalle y la puntualidad del equipo superaron nuestras expectativas.",
    name: "Consulting FGC",
    job: "Gerente de Operaciones",
    srcImg: fgcImg,
  },
];

// --- DATOS ESTRUCTURADOS (SEO) ---
const schemaData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Testimonios de Clientes",
  itemListElement: testimonials.map((t, index) => ({
    "@type": "Review",
    position: index + 1,
    itemReviewed: {
      "@type": "Organization",
      name: "Berth Ortiz",
    },
    author: {
      "@type": "Person",
      name: t.name,
    },
    reviewBody: t.description,
    reviewRating: {
      "@type": "Rating",
      ratingValue: "5",
      bestRating: "5",
    },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

<section
  class="lg:max-w-7xl mx-auto h-fit flex md:items-center relative text-gray-600 body-font md:py-20"
>
  <div
    class="w-full flex flex-col md:gap-5 lg:max-w-7xl mx-auto py-10 px-6 md:px-14 items-center"
  >
    <header
      class="w-full flex flex-col md:justify-center md:items-center text-center mb-16 md:mb-0"
    >
      <span
        class="rounded-full bg-green-50 px-4 py-1 text-sm font-bold tracking-wide text-green-800"
      >
        Testimonios
      </span>
      <h2
        class="title-font sm:text-4xl lg:text-5xl text-3xl mb-4 pt-5 font-medium text-slate-900"
      >
        Vea lo que dicen mis <span class="gradiente-title-g">clientes</span>
      </h2>
      <p
        class="md:max-w-[75ch] mb-1 md:mb-8 leading-relaxed font-normal text-[1.1em] text-slate-700"
      >
        He tenido la suerte de trabajar con personas y empresas increíbles. Más
        que clientes, los considero compañeros de proyecto, y estas son sus
        palabras sobre el camino que recorrimos juntos.
      </p>
    </header>

    <div class="swiper mySwiper w-full relative h-[310px]">
      <div class="swiper-wrapper">
        {
          testimonials.map((testimonial) => (
            <div class="swiper-slide">
              <figure class="flex flex-col justify-between gap-4 rounded-2xl border border-slate-200 bg-white p-8 text-left shadow-md">
                <div class="flex text-amber-500" aria-label="5 estrellas">
                  <Icon name="star" size={20} />
                  <Icon name="star" size={20} />
                  <Icon name="star" size={20} />
                  <Icon name="star" size={20} />
                  <Icon name="star" size={20} />
                </div>

                <blockquote class="text-slate-700">
                  <p>"{testimonial.description}"</p>
                </blockquote>

                <figcaption class="flex gap-4 mt-3">
                  <div class="w-12 h-12 overflow-hidden rounded-full bg-green-100">
                    <img
                      src={testimonial.srcImg.src}
                      alt={`Foto de ${testimonial.name}`}
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                  </div>
                  <div class="flex flex-col">
                    <cite class="font-bold not-italic text-slate-900">
                      {testimonial.name}
                    </cite>
                    <span class="text-sm text-slate-600">
                      {testimonial.job}
                    </span>
                  </div>
                </figcaption>
              </figure>
            </div>
          ))
        }
      </div>

      <div class="swiper-button-next"></div>
      <div class="swiper-button-prev"></div>

      <div class="swiper-pagination !relative mt-5"></div>
    </div>
  </div>
</section>

<script>
  import Swiper from "swiper";
  import { Pagination, Autoplay, FreeMode, Navigation } from "swiper/modules";

  // Estilos necesarios
  import "swiper/css";
  import "swiper/css/pagination";
  import "swiper/css/navigation";

  // Inicialización
  const initSwiper = () => {
    new Swiper(".mySwiper", {
      modules: [Pagination, Navigation, Autoplay, FreeMode],
      slidesPerView: 1,
      spaceBetween: 20,
      loop: true,
      speed: 1200,
      autoplay: {
        delay: 4000,
        disableOnInteraction: false,
      },
      pagination: {
        el: ".swiper-pagination",
        clickable: true,
      },
      navigation: {
        nextEl: ".swiper-button-next",
        prevEl: ".swiper-button-prev",
      },
      breakpoints: {
        640: { slidesPerView: 2 },
        1024: { slidesPerView: 2 },
      },
    });
  };

  initSwiper();
</script>

<style>
  .swiper-slide {
    /* height: auto; */
    display: flex;
  }

  :global(.swiper-pagination-bullet-active) {
    background-color: var(--color-brand) !important;
    width: 20px;
    border-radius: 5px;
  }

  .swiper-button-next,
  .swiper-button-prev {
    --swiper-navigation-color: #166534;
    background: #fff;
    top: 40% !important;
    /* left: % !important; */
    width: 40px;
    height: 40px;
    padding: 8px;
    border: 1px solid #d1d5db;
    border-radius: 50%;
    box-shadow: 0 4px 8px -1px rgb(15 23 42 / 0.16);
  }

  .swiper-button-prev {
    left: 10px !important;
  }
  .swiper-button-next {
    right: 10px !important;
  }
  .swiper-pagination-bullet {
    background: #9ca3af !important;
  }
  .swiper-horizontal > .swiper-pagination-bullets,
  .swiper-pagination-horizontal.swiper-pagination-bullets {
    .swiper-pagination-bullet {
      background: #9ca3af;
      /* margin: 0 var(--swiper-pagination-bullet-horizontal-gap, 4px); */
    }
  }
</style>
