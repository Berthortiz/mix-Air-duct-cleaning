---
import { Icon } from "astro-icon/components";
import ButtonPrimary from "../components/ButtonPrimary.astro";

interface Props {
    phone?: string;
    whatsappLink?: string;
}

const {
    phone = "+1 (407) 601-8961",
    whatsappLink = "https://wa.me/14076018961",
} = Astro.props;

const services = [
    {
        eyebrow: "Servicio residencial y comercial",
        title: "Air Duct Cleaning",
        description:
            "Los ductos de aire acumulan polvo, moho y alérgenos que circulan cada vez que enciendes el aire acondicionado. Nuestro servicio elimina estos contaminantes del sistema HVAC, mejorando la calidad del aire, reduciendo alergias y optimizando el rendimiento del equipo.",
        image: "/mix-contact-2.png",
        imageAlt: "Técnicos limpiando los ductos de aire en una vivienda",
    },
    {
        eyebrow: "Mantenimiento preventivo",
        title: "Mantenimiento Preventivo de Aires Acondicionados",
        description:
            "Evita fallas costosas y alarga la vida útil de tu equipo. Si notas polvo acumulado, malos olores o alergias frecuentes, nuestro servicio ayuda a eliminar ácaros, moho y contaminantes en propiedades de toda Florida.",
        image: "/aire-acondicionado.webp",
        imageAlt:
            "Comparación del equipo de aire acondicionado antes y después del mantenimiento",
    },
    {
        eyebrow: "Servicio de Junk Removal",
        title: "Retiro de Muebles y Artículos Voluminosos",
        description:
            "Despejamos tu hogar o propiedad retirando muebles, enseres y objetos que ya no necesitas. Contáctanos para coordinar el servicio en Orlando y sus alrededores.",
        image: "/removal-junk.webp",
        imageAlt:
            "Equipo Mix Service retirando muebles y objetos voluminosos de una vivienda",
    },
];
---

<div
    id="services-duct-cleaning"
    data-id="378caa2"
    class="duct-cleaning-container lg:max-w-7xl mx-auto px-5 py-10 flex flex-col gap-2 text-white"
>
    {
        services.map((service, index) => (
            <section class="bg-white p-2 rounded-2xl flex flex-col lg:flex-row gap-8 items-center">
                <div class="flex-1">
                    <span class="text-sm font-bold uppercase tracking-wider text-emerald-600">
                        {service.eyebrow}
                    </span>
                    <h2 class="text-2xl md:text-5xl font-bold text-slate-900 mt-2 mb-4">
                        {service.title}
                    </h2>

                    <p class="text-slate-600 leading-relaxed mb-6">
                        {service.description}
                    </p>
                    <div class="flex flex-wrap gap-4 items-center">
                        <a
                            href={whatsappLink}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center justify-center gap-2 rounded-full bg-(--color-brand) px-6 py-3 font-semibold text-white transition-colors hover:brightness-110"
                            aria-label="Escríbenos por WhatsApp"
                        >
                            <Icon name="whatsapp-solid" size={22} />
                            Mensaje vía WhatsApp
                        </a>
                        <a
                            href={`tel:${phone}`}
                            class="text-slate-700 font-bold hover:text-emerald-600 text-lg"
                        >
                            {phone}
                        </a>
                    </div>
                </div>
                <img
                    src={service.image}
                    alt={service.imageAlt}
                    class:list={[
                        "order-first w-full lg:w-5/12 aspect-4/3 object-cover rounded-xl",
                        index !== 1 && "lg:order-0",
                    ]}
                    loading={index === 0 ? "eager" : "lazy"}
                    fetchpriority={index === 0 ? "high" : "auto"}
                />
            </section>
        ))
    }
</div>
