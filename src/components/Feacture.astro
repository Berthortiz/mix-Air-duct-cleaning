---
import IconCheck from "../components/Icons/IconCheck.astro";
import { Picture } from "astro:assets";
import defaultBg from "../assets/ductos-sucios.png";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";

interface Props {
    flexRowRevers?: boolean;
    bgImg?: ImageMetadata;
}

const { flexRowRevers = true, bgImg = defaultBg } = Astro.props;
---

<section
    class="w-full h-fit flex md:items-center relative text-gray-600 body-font pt-16"
>
    <div
        class:list={[
            {
                "md:flex-row-reverse": flexRowRevers,
                "md:flex-row": !flexRowRevers,
            },
        ]}
        class=`flex flex-col md:gap-20 lg:max-w-7xl mx-auto py-10 px-6 md:px-14 items-center relative z-10`
    >
        <div
            class="md:w-1/2 flex flex-col md:justify-center md:items-start md:text-left mb-16 md:mb-0 items-start text-start"
        >
            <spam class="text font-semibold"
                >Mantenimiento Preventivo de Aires Acondicionados</spam
            >

            <h2
                class="text-(--color-brand)
                leading-10 md:leading-14 lg:leading-10 xl:leading-14
                font-bold
                text-4xl md:text-5xl lg:text-4xl xl:text-5xl
                mb-4"
            >
                ¿Rejillas sucias? <br /> Es Señal que tus ductos necesita limpieza!
                <br />
            </h2>
            <p
                class="md:max-w-[55ch] mb-8 lg:text-[1em] leading-relaxed font-normal text-[1.1em] text-gray-700"
            >
                ¿Notas polvo acumulado, malos olores o alergias frecuentes?
                Nuestros servicios de limpieza de ductos de aire están diseñados
                para mejorar la calidad del aire que respiras. Atendemos
                propiedades residenciales y comerciales en toda Florida,
                eliminando polvo, moho, ácaros y otros contaminantes que se
                acumulan en los sistemas HVAC con el tiempo.
            </p>
            <a
                href="https://wa.link/bqgy6d"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 rounded-full bg-(--color-brand) px-6 py-3 font-semibold text-white transition-colors hover:brightness-110"
                aria-label="Escríbenos por WhatsApp"
            >
                <!-- <Icon name="whatsapp-solid" size={22} /> -->
                Agendar una cita
            </a>
            <!-- <ul class="flex flex-col gap-4 text-[1.1em]">
                <li class="flex gap-3">
                    <span class="fill-current text-(--color-brand) mt-1">
                        <IconCheck size={22} />
                    </span>
                    <div>
                        <h3 class="font-bold">Sed do eiusmod tempor"</h3>
                        <p>
                            Curabitur pretium tincidunt lacus. Nulla gravida
                            orci a odio.
                        </p>
                    </div>
                </li>
                <li class="flex gap-3">
                    <span class="fill-current text-(--color-brand) mt-1">
                        <IconCheck size={22} />
                    </span>
                    <div>
                        <h3 class="font-bold">
                            Estrategi qui officia deserunt"
                        </h3>
                        <p>Quas, molestiae aperiam incidunt repudiandae</p>
                    </div>
                </li>
            </ul> -->

            <div class="flex justify-center">
                <!-- <a
                    class="inline-flex text-white bg-(--color-brand) border-0 py-2 px-6 focus:outline-none hover:bg-indigo-600 rounded text-lg"
                    >Button</a
                > -->
            </div>
        </div>
        <div class="md:w-1/2">
            <Picture
                src={bgImg}
                alt="testimonial"
                formats={["webp"]}
                quality={80}
                loading="lazy"
                decoding="async"
                class="w-full object-contain"
            />
        </div>
